# ── Frontend environment ────────────────────────────────────────────
# Copy this file to `.env.local` and adjust. Vite only exposes vars
# prefixed with VITE_ to the browser.

# When "true", all API calls resolve from src/mocks/ instead of hitting
# the network. Set to "false" once your backend is ready.
VITE_USE_MOCK=true

# Base URL the API client prepends to every request path.
# Examples:
#   /api                       -> use the Vite dev proxy (see vite.config.js)
#   http://localhost:8000      -> talk directly to a local FastAPI server
VITE_API_BASE_URL=/api
